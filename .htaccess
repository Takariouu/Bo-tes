Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

# Fichiers statiques : les CSS, JS, icônes et favicons sont appelés avec ?v=<date de modification>
# (src/View.php::asset), donc mis en cache longtemps ; les images appelées depuis la CSS, 7 jours.
<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:png|jpe?g|gif|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

# mod_rewrite est obligatoire : sans lui, Apache renvoie une erreur au lieu d'exposer les fichiers internes.
RewriteEngine On
RewriteBase /

# 1. Fichiers et dossiers cachés (.git, .env, .htaccess...)
RewriteRule (?:^|/)\. - [F,L]

# 2. Seules les ressources statiques de /assets sont servies directement
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^assets/.+\.(?:css|js|png|jpe?g|gif|svg|webp|ico|woff2?)$ - [L,NC]

# 3. Contrôleur frontal (cible des réécritures ci-dessous)
RewriteRule ^index\.php$ - [L]

# 4. Liste blanche : tout autre fichier ou dossier existant est interdit
#    (config, src, includes, pages, storage, tests, README...)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.+$ - [F,L]

# 5. Routage de toutes les autres URL vers le contrôleur frontal
RewriteRule ^(.*)$ index.php?page=$1 [QSA,L]
