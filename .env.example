# Copiez ce fichier en .env (jamais versionné) puis renseignez les valeurs.
# Les variables définies côté serveur (SetEnv Apache, pool PHP-FPM) restent prioritaires.

# production (par défaut) | development
APP_ENV=production

# Connexion MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=HEBERGEUR_MC
DB_USER=bootes_user
DB_PASS=

# Stockage privé (instances Minecraft, sauvegardes, archives téléversées).
# En production, placez-le HORS de la racine web, par exemple /var/lib/bootes,
# appartenant à l'utilisateur du serveur web avec des droits 0750.
BOOTES_STORAGE_PATH=

# Annuaire : vérification du statut des serveurs externes (ping Minecraft sortant). 0 pour la désactiver.
BOOTES_DIRECTORY_PING=1
